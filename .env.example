# ---------------------------------------------------------------------------
# Server (required to run the MCP server)
# ---------------------------------------------------------------------------

# Connection used to serve MCP requests. Point this at the read-only mcp_reader
# role, which holds EXECUTE on the search functions, no grant on the Prisma-owned
# tables, and INSERT/UPDATE on the mcp_* auth and audit tables only.
DATABASE_URL=postgresql://mcp_reader:password@host:6543/postgres?pgbouncer=true

PORT=3000

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# How callers authenticate:
#
#   oauth — Google sign-in, restricted to @amana.id accounts that already exist
#           in the dashboard. The only mode that can attribute a request to a
#           person, and the only one that enforces the domain restriction.
#   token — the legacy shared bearer token. Anyone holding the string can
#           connect, and their requests cannot be attributed to anybody.
#   both  — accepts either, for migrating an existing connector without downtime.
#
# Defaults to oauth when the Google variables below are set, token otherwise.
MCP_AUTH_MODE=oauth

# Public origin of this server, with no path. Becomes the OAuth issuer and the
# base of the RFC 8707 resource identifier (<origin>/mcp), so it must match the
# URL people enter in Claude. Must be https outside localhost.
MCP_PUBLIC_URL=https://amana-mcp.up.railway.app

# Google OAuth client (Google Cloud console > APIs & Services > Credentials,
# type "Web application"). Register <MCP_PUBLIC_URL>/oauth/google/callback as an
# authorised redirect URI. This is a separate client from the dashboard's,
# because the redirect URI differs.
MCP_GOOGLE_CLIENT_ID=
MCP_GOOGLE_CLIENT_SECRET=

# Override only if the callback is reached at a different URL than
# <MCP_PUBLIC_URL>/oauth/google/callback.
# MCP_GOOGLE_REDIRECT_URI=

# Dashboard roles whose MCP sessions may read deliverables marked confidential.
# Comma-separated. Everyone else gets the public and internal corpus only.
MCP_CONFIDENTIAL_ROLES=admin

# Email domain MCP access is restricted to. Must match ALLOWED_EMAIL_DOMAIN in
# amana-ai-operational/src/lib/auth-domain.ts.
# MCP_ALLOWED_EMAIL_DOMAIN=amana.id

# Token lifetimes. The defaults are one hour and thirty days; a shorter access
# token means a role change in the dashboard takes effect sooner.
# MCP_ACCESS_TOKEN_TTL_SECONDS=3600
# MCP_REFRESH_TOKEN_TTL_SECONDS=2592000

# Required when MCP_AUTH_MODE is token or both. A static token carries no
# identity, so it is recorded in the audit log as a service principal rather
# than a person, and the @amana.id restriction does not apply to it.
MCP_BEARER_TOKEN=

# Optional second static token that also unlocks confidential deliverables.
# Must differ from MCP_BEARER_TOKEN. Leave unset to keep confidential documents
# unreachable by static-token callers. Ignored in oauth mode, where
# confidentiality follows the signed-in user's role instead.
MCP_BEARER_TOKEN_PRIVILEGED=

# ---------------------------------------------------------------------------
# Tooling (required for sql/ migrations and the evaluation scripts, not by the
# running server)
# ---------------------------------------------------------------------------

# Session-mode connection, used for schema changes and for writing entity
# embeddings. Note the naming here is the reverse of what it suggests: on this
# project DATABASE_URL is the transaction-mode pooler (port 6543,
# pgbouncer=true) and DIRECT_URL is the session-mode pooler (port 5432).
# Multi-statement, dollar-quoted DDL fails on the transaction-mode pooler, so
# `npm run db:apply` and the backfill script both use DIRECT_URL.
DIRECT_URL=postgresql://user:password@host:5432/postgres

# The mcp_reader connection string. `npm run smoke:auth` uses it to prove the
# grants in sql/004_mcp_auth.sql are sufficient for the whole sign-in flow.
MCP_READER_DATABASE_URL=

# Used only by `npm run eval:generate`, which regenerates the 100-question
# evaluation set. Not needed to run the server, apply migrations, or run
# `npm run eval:probe`.
ANTHROPIC_API_KEY=
