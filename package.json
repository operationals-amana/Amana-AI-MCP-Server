{
  "name": "amana-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "db:apply": "node scripts/apply-sql.mjs",
    "smoke:auth": "node scripts/smoke-oauth.mjs",
    "eval:plan": "node eval/generate-golden-set.mjs --dry-run",
    "eval:generate": "node eval/generate-golden-set.mjs",
    "eval:probe": "node eval/probe-retrieval.mjs --json eval/baseline-retrieval.json",
    "eval:embed": "$HOME/.pyenv/versions/3.11.11/envs/proposal-agent/bin/python scripts/embed-golden-set.py",
    "eval:backfill": "$HOME/.pyenv/versions/3.11.11/envs/proposal-agent/bin/python scripts/backfill-entity-embeddings.py"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
